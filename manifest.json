{
  "manifest_version": 3,
  "name": "Instagram Comment & Reels Exporter",
  "version": "4.2.0",
  "description": "Export all comments of any Instagram post or reel, or all reels of a profile, to CSV. Runs in your own tab — no account needed.",
  "author": "hammadi.dev",
  "homepage_url": "https://hammadi.dev",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Instagram comments & reels"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ]
}
